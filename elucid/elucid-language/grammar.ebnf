(* EQL — EBNF Grammar *)

(* ---- Lexical tokens ---- *)

integer = [ "-" ] , digit+                        ;
string  = '"' , ( char | escape )* , '"'          ;
ident   = alpha , ( alpha | digit | "_" )*        ;
digit   = ? 0..9 ?                                ;
alpha   = ? a..z | A..Z | _ ?                     ;
char    = ? any character except '"' and '\' ?    ;
escape  = "\" , ( "t" | "n" | "\"" | "\" | "u" )  ;

(* ---- Keywords ---- *)
(* Command keywords are contextual: they may also be used as names where the
   grammar expects an identifier. Operator and literal keywords stay reserved. *)

command_keyword = "source" | "project" | "filter" | "sort" | "take" | "summarize" ;
keyword         = command_keyword | "by" | "and" | "or" | "not" | "null" | "true" | "false" ;
name            = ident | command_keyword ;

(* ---- Top-level ---- *)

query = "source" , name , ( "|" , command )* ;

(* ---- Commands ---- *)

command = project_command
        | filter_command
        | sort_command
        | take_command
        | summarize_command
        ;

project_command = "project" , expression , { "," , expression } ;

filter_command = "filter" , expression ;

sort_command      = "sort" , [ "by" ] , sort_command_item , { "," , sort_command_item } ;
sort_command_item = [ "+" | "-" ] , sort_command_atom ;
sort_command_atom = call
                  | field
                  | "(" , expression , ")"
                  ;

take_command = "take" , integer ;

summarize_command      = "summarize" , summarize_command_item , { "," , summarize_command_item } , [ "by" , expression , { "," , expression } ] ;
summarize_command_item = name , "=" , expression
                       | call
                       | field
                       ;

(* ---- Expressions ---- *)
(* All operators are left-associative (except not, which is prefix).
   Precedence from highest to lowest binding:
     not (prefix)
     *  /
     +  -
     ==  !=  >  >=  <  <=
     and
     or                                                           *)

expression = or_expression ;

or_expression = and_expression , { "or" , and_expression } ;

and_expression = comparison_expression , { "and" , comparison_expression } ;

comparison_expression = additive_expression , { ( "==" | "!=" | ">" | ">=" | "<" | "<=" ) , additive_expression } ;

additive_expression = multiplicative_expression , { ( "+" | "-" ) , multiplicative_expression } ;

multiplicative_expression = unary_expression , { ( "*" | "/" ) , unary_expression } ;

unary_expression = "not" , unary_expression
                 | atom
                 ;

atom = integer
     | string
     | "null"
     | "true" | "false"
     | call
     | field
     | "(" , expression , ")"
     ;

call = name , "(" , [ expression , { "," , expression } ] , ")" ;

field = name ; (* a bare identifier not followed by "(" *)
