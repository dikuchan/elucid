---
source: elucid-language/src/semantic/pipeline.rs
expression: pipeline
---
Pipeline {
    source: SourceSpec {
        dataset: "test",
    },
    time_range: TimeRange {
        earliest: None,
        latest: None,
    },
    stages: [
        Filter(
            Binary(
                Equal,
                Field(
                    FieldRef {
                        name: "status",
                    },
                ),
                Literal(
                    Number(
                        200.0,
                    ),
                ),
            ),
        ),
        Sort(
            [
                SortSpec {
                    expr: Field(
                        FieldRef {
                            name: "count",
                        },
                    ),
                    order: Descending,
                },
            ],
        ),
        Limit(
            5,
        ),
    ],
}
